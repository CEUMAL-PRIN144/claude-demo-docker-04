PORT=3000

# Data source: "json" (default) or "mysql"
DATA_SOURCE=json

# JSON file storage (used when DATA_SOURCE=json)
JSON_DB_PATH=./data/todos.json

# MySQL storage (used when DATA_SOURCE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=todo_app

# Origins allowed to call the API from a browser (CORS).
# "*" (default) allows any origin; otherwise a comma-separated list.
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080
